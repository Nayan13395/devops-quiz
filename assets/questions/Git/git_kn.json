  {"category": "Git", "set": 4, "question": "git blame ಏನನ್ನು ತೋರಿಸುತ್ತದೆ?", "options": ["ಪ್ರತಿ ಸಾಲನ್ನು ಯಾರು ಬದಲಾಯಿಸಿದರು", "ರೆಪೊಸಿಟರಿ ಗಾತ್ರ", "ಬ್ರಾಂಚ್‌ಗಳು", "ಟ್ಯಾಗ್‌ಗಳು"], "answer": "ಪ್ರತಿ ಸಾಲನ್ನು ಯಾರು ಬದಲಾಯಿಸಿದರು"},
  {"category": "Git", "set": 4, "question": "ರೆಪೊಸಿಟರಿ ಸಮಗ್ರತೆಯನ್ನು ಪರಿಶೀಲಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git fsck", "git verify", "git check", "git validate"], "answer": "git fsck"},
  {"category": "Git", "set": 4, "question": "git gc ಏನು ಮಾಡುತ್ತದೆ?", "options": ["ರೆಪೊಸಿಟರಿ ಸ್ವಚ್ಛತೆ ಮತ್ತು ಅತ್ಯುತ್ತಮೀಕರಣ", "ರೆಪೊಸಿಟರಿ ಅಳಿಸುವುದು", "ಬ್ರಾಂಚ್ ರಚಿಸುವುದು", "ಕಮಿಟ್‌ಗಳನ್ನು ಪುಶ್ ಮಾಡುವುದು"], "answer": "ರೆಪೊಸಿಟರಿ ಸ್ವಚ್ಛತೆ ಮತ್ತು ಅತ್ಯುತ್ತಮೀಕರಣ"},
  {"category": "Git", "set": 4, "question": "Git LFS ಅನ್ನು ಯಾವುದಕ್ಕಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ?", "options": ["ದೊಡ್ಡ ಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಲು", "ಬ್ರಾಂಚ್ ನಿರ್ವಹಣೆ", "ವಿಲೀನ ಸಂಘರ್ಷಗಳು", "CI/CD"], "answer": "ದೊಡ್ಡ ಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಲು"},
  {"category": "Git", "set": 5, "question": "ಪ್ರತಿ ಕಮಿಟ್‌ಗೆ ಒಂದು ಸಾಲಿನಂತೆ ಕಮಿಟ್ ಇತಿಹಾಸವನ್ನು ತೋರಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git list -o", "git log --oneline", "git history -1", "git show --short"], "answer": "git log --oneline"},
  {"category": "Git", "set": 5, "question": "ಹೊಸ ಬ್ರಾಂಚ್ ಅನ್ನು ರಚಿಸಿ ಅದಕ್ಕೆ ಸ್ವಿಚ್ ಮಾಡುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git checkout --create", "git new feature", "git branch -s feature", "git switch -c feature"], "answer": "git switch -c feature"},
  {"category": "Git", "set": 5, "question": "ಫೈಲ್ ಅನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿ ಆದರೆ ವರ್ಕಿಂಗ್ ಡೈರೆಕ್ಟರಿಯಲ್ಲಿ ಉಳಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git rm --cached", "git rm -f", "git reset --hard", "git clean -f"], "answer": "git rm --cached"},
  {"category": "Git", "set": 5, "question": "ಲೇಖಕರ ಪ್ರಕಾರ ಗುಂಪು ಮಾಡಿ ಕಮಿಟ್ ಸಂಖ್ಯೆಗಳ ಸಾರಾಂಶ ನೀಡುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git shortlog -sn", "git blame", "git describe", "git log --stat"], "answer": "git shortlog -sn"},
  {"category": "Git", "set": 5, "question": "Git ಟ್ರ್ಯಾಕ್ ಮಾಡಬಾರದ ಫೈಲ್‌ಗಳ ಮಾದರಿಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡುವ ಫೈಲ್ ಯಾವುದು?", "options": [".gitignore", ".gitmodules", ".gitkeep", ".gitconfig"], "answer": ".gitignore"},
  {"category": "Git", "set": 5, "question": "ಮತ್ತೊಂದು ಬ್ರಾಂಚ್‌ನ ನಿರ್ದಿಷ್ಟ ಕಮಿಟ್ ಅನ್ನು ಪ್ರಸ್ತುತ ಬ್ರಾಂಚ್‌ಗೆ ಅನ್ವಯಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git copy", "git cherry-pick", "git merge-pick", "git graft"], "answer": "git cherry-pick"},
  {"category": "Git", "set": 5, "question": "ಇನ್ನೂ ಸ್ಟೇಜ್ ಮಾಡದ ಬದಲಾವಣೆಗಳನ್ನು ತೋರಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git diff", "git log -p", "git status -d", "git show"], "answer": "git diff"},
  {"category": "Git", "set": 5, "question": "ಟ್ರ್ಯಾಕ್ ಮಾಡಿದ ಫೈಲ್‌ನ ಹೆಸರನ್ನು ಬದಲಾಯಿಸಿ ಆ ಬದಲಾವಣೆಯನ್ನು ಸ್ಟೇಜ್ ಮಾಡುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git tag", "git mv", "git rename", "git patch"], "answer": "git mv"},
  {"category": "Git", "set": 5, "question": "origin ಎಂಬ ಹೆಸರಿನ ರಿಮೋಟ್ ಅನ್ನು ಸೇರಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git remote add origin <url>", "git origin add <url>", "git connect origin <url>", "git add remote origin <url>"], "answer": "git remote add origin <url>"},
  {"category": "Git", "set": 5, "question": "ಇತಿಹಾಸದಲ್ಲಿ ಬಿಡುಗಡೆ ಬಿಂದುವನ್ನು ಗುರುತಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git mark", "git tag", "git stamp", "git label"], "answer": "git tag"},
  {"category": "Git", "set": 5, "question": "ಫೈಲ್‌ನ ಪ್ರತಿ ಸಾಲನ್ನು ಕೊನೆಯದಾಗಿ ಯಾರು ಬದಲಾಯಿಸಿದರು ಎಂದು ತೋರಿಸುವ ಕಮಾಂಡ್ ಯಾವುದು?", "options": ["git author", "git who", "git blame", "git trace"], "answer": "git blame"},
  {"category": "Git", "set": 5, "question": "Git ನಲ್ಲಿ HEAD ಏನನ್ನು ಪ್ರತಿನಿಧಿಸುತ್ತದೆ?", "options": ["ಪ್ರಸ್ತುತ ಚೆಕ್‌ಔಟ್ ಮಾಡಿದ ಕಮಿಟ್ ಉಲ್ಲೇಖ", "ರೆಪೊಸಿಟರಿಯ ಮೊದಲ ಕಮಿಟ್", "ಸ್ಟೇಜಿಂಗ್ ಪ್ರದೇಶ", "ರಿಮೋಟ್ ಡೀಫಾಲ್ಟ್ ಬ್ರಾಂಚ್"], "answer": "ಪ್ರಸ್ತುತ ಚೆಕ್‌ಔಟ್ ಮಾಡಿದ ಕಮಿಟ್ ಉಲ್ಲೇಖ"},
