  {"category": "Git", "set": 5, "question": "Git ಟ್ರ್ಯಾಕ್ ಮಾಡದ ಡೈರೆಕ್ಟರಿಗಳನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸುವ ಫ್ಲ್ಯಾಗ್", "options": ["git clean -fd", "git diff --cached", "git commit --amend", "git fetch"], "answer": "git clean -fd"},
