  {"category": "Git", "set": 4, "question": "Git bisect ಒಳ್ಳೆಯದು ಎಂದು ಗುರುತಿಸುವುದು", "options": ["git bisect good", "git diff --cached", "git commit --amend", "git fetch"], "answer": "git bisect good"},
