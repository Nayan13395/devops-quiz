# Release signing configuration — used by android/app/build.gradle.kts.
# Copy this file to android/key.properties and fill in the real passwords.
# key.properties is gitignored; NEVER commit real passwords.
#
# This is the same keystore used for the Google Play Console uploads
# (alias key0). The 'test' keystore in the user profile contains key1
# and is NOT the Play keystore.
storeFile=C:/Users/Nayan/devops
keyAlias=key0
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
