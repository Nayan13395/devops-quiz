  "gameHintWord432Null": "பொருள் அல்லது முடிவு இல்லாததைக் குறிக்கும் மதிப்பு.",
  "gameHintWord433Undefined": "ஒதுக்கப்பட்ட மதிப்பு இல்லாததற்கான JavaScript மதிப்பு.",
  "gameHintWord434Promise": "இறுதியில் வரும் ஒத்திசைவற்ற முடிவைக் குறிக்கும் JavaScript பொருள்.",
  "gameHintWord435Async": "ஒத்திசைவற்ற செயல்பாட்டைக் குறிக்கும் திறவுச்சொல்.",
  "gameHintWord436Await": "ஒத்திசைவற்ற முடிவுக்காகக் காத்திருக்கும் திறவுச்சொல்.",
  "gameHintWord437Callback": "மற்றொரு செயல்பாடு அழைக்கும்படி வழங்கப்படும் செயல்பாடு.",
  "gameHintWord438Closure": "தன்னைச் சூழ்ந்த லெக்சிகல் வரம்புக்கான அணுகலைத் தக்கவைக்கும் செயல்பாடு.",
  "gameHintWord439Generator": "yield செய்யப்பட்ட மதிப்புகள் மூலம் தொடரை சோம்பலாக உருவாக்கும் செயல்பாடு.",
  "gameHintWord440Iterator": "தொகுப்பில் உள்ள மதிப்புகள் வழியாக முன்னேறும் பொருள்.",
  "gameHintWord441Print": "மதிப்பை வெளியீட்டில் எழுதும் பொதுவான செயல்பாடு.",
  "gameHintWord442Input": "நிலையான உள்ளீட்டிலிருந்து ஒரு வரியைப் படிக்கும் Python செயல்பாடு.",
  "gameHintWord443Open": "கோப்பு கைப்பிடியைப் பெறப் பயன்படும் செயல்பாடு.",
  "gameHintWord444Close": "திறந்த கோப்பு அல்லது இணைப்பை விடுவிக்கும் செயல்பாடு.",
  "gameHintWord445Read": "ஸ்ட்ரீம் அல்லது கோப்பிலிருந்து தரவைப் பெறும் செயல்பாடு.",
  "gameHintWord446Write": "ஸ்ட்ரீம் அல்லது கோப்பிற்கு தரவை அனுப்பும் செயல்பாடு.",
  "gameHintWord447Append": "தொகுப்பின் இறுதியில் ஒரு உருப்படியைச் சேர்க்கிறது.",
  "gameHintWord448Split": "பிரிப்பானைக் கொண்டு உரையை துணைச் சரங்களாகப் பிரிக்கிறது.",
  "gameHintWord449Join": "பிரிப்பானைக் கொண்டு சரங்களின் வரிசையை இணைக்கிறது.",
  "gameHintWord450Strip": "Python சரத்தைச் சுற்றியுள்ள வெற்றிடங்களை நீக்குகிறது.",
  "gameHintWord451Chomp": "Perl அல்லது Ruby இல் இறுதிப் பதிவுப் பிரிப்பானை நீக்குகிறது.",
  "gameHintWord452Map": "தொகுப்பின் ஒவ்வொரு உருப்படிக்கும் ஒரு மாற்றத்தைப் பயன்படுத்துகிறது.",
  "gameHintWord453Filter": "நிபந்தனையை நிறைவு செய்யும் தொகுப்பு உருப்படிகளை மட்டும் வைத்திருக்கிறது.",
  "gameHintWord454Reduce": "தொகுப்பை திரட்டப்பட்ட ஒரே முடிவாக இணைக்கிறது.",
  "gameHintWord455Range": "முழு எண்களின் கூட்டுத் தொடரைக் குறிக்கும் Python வகை.",
  "gameHintWord456Length": "தொகுப்பின் அளவைத் திருப்பித் தரும் பண்பு அல்லது முறை.",
  "gameHintWord457Len": "தொகுப்பின் அளவைத் திருப்பித் தரும் Python உள்ளமைந்த செயல்பாடு.",
  "gameHintWord458Type": "பொருளின் வகையைத் திருப்பித் தரும் Python செயல்பாடு.",
  "gameHintWord459Isinstance": "வகை படிநிலையில் உறுப்பினரா எனச் சரிபார்க்கும் Python செயல்பாடு.",
  "gameHintWord460Yield": "ஜெனரேட்டரிலிருந்து மதிப்பை உருவாக்கும் திறவுச்சொல்.",
  "gameHintWord461Saas": "முழுமையான மென்பொருள் பயன்பாடுகளை வழங்கும் கிளவுட் மாதிரி.",
  "gameHintWord462Paas": "நிர்வகிக்கப்படும் பயன்பாட்டு மேம்பாட்டு தளத்தை வழங்கும் கிளவுட் மாதிரி.",
  "gameHintWord463Iaas": "மெய்நிகர் கணினி, சேமிப்பு, நெட்வொர்க்கிங் வழங்கும் கிளவுட் மாதிரி.",
  "gameHintWord464Hybrid": "தனியார் மற்றும் பொது உள்கட்டமைப்பை இணைக்கும் கிளவுட் அணுகுமுறை.",
  "gameHintWord465Archive": "அரிதாக அணுகப்படும் தரவின் நீண்டகால சேமிப்பு.",
  "gameHintWord466Public": "பல வாடிக்கையாளர்களுக்கு சேவைகளை வழங்கும் கிளவுட் உரிமை மாதிரி.",
  "gameHintWord467Private": "ஒரே நிறுவனத்திற்கு அர்ப்பணிக்கப்பட்ட கிளவுட் மாதிரி.",
  "gameHintWord468Scalability": "வளங்களைச் சேர்த்து அதிகரிக்கும் சுமையைக் கையாளும் திறன்.",
  "gameHintWord469Availability": "தேவைப்படும்போது சேவை அணுகக்கூடியதாக இருக்கும் அளவு.",
  "gameHintWord470Resilience": "தோல்விகளைத் தாங்கி மீளும் திறன்.",
  "gameHintWord471Redundancy": "ஒற்றைத் தோல்விப் புள்ளிகளைக் குறைக்கும் நகல் கூறுகள்.",
  "gameHintWord472Disaster": "மீட்பு உத்தியால் எதிர்கொள்ளப்படும் பெரிய செயலிழப்பு.",
  "gameHintWord473Recovery": "தோல்விக்குப் பிறகு சேவை அல்லது தரவை மீட்டெடுத்தல்.",
  "gameHintWord474Replicate": "தரவு அல்லது பணிச்சுமைகளை வேறு இடத்திற்கு நகலெடு.",
  "gameHintWord475Snapshotting": "தரவு அல்லது அமைப்பு நிலையின் குறிப்பிட்ட நேர நகல்களை எடுத்தல்.",
  "gameHintWord476Restore": "சேமித்த நகலிலிருந்து தரவை மீட்டெடுக்கும் செயல்பாடு.",
  "gameHintWord477Residency": "சேமிக்கப்பட்ட தரவின் புவியியல் இருப்பிடத்தை வரையறுக்கும் தேவை.",
  "gameHintWord478Compliance": "தேவையான விதிமுறைகளையும் நிறுவனக் கட்டுப்பாடுகளையும் பூர்த்தி செய்தல்.",
  "gameHintWord479Governance": "தொழில்நுட்பப் பயன்பாட்டைக் கட்டுப்படுத்தும் கொள்கைகளும் செயல்முறைகளும்.",
  "gameHintWord480Audit": "பதிவு செய்யப்பட்ட செயல்பாடுகள் மற்றும் இணக்கச் சான்றுகளின் மதிப்பாய்வு.",
  "gameHintWord481Token": "அங்கீகாரம் அல்லது அடையாளத்தைக் குறிக்கும் சான்று அல்லது குறியீடு.",
  "gameHintWord482Oauth": "பிரதிநிதித்துவ அணுகலை அனுமதிக்கும் அங்கீகார கட்டமைப்பு.",
  "gameHintWord483Saml": "நிறுவன ஒற்றை உள்நுழைவுக்கு பொதுவாகப் பயன்படும் XML அடிப்படையிலான தரநிலை.",
  "gameHintWord484Cmdlet": "PowerShell பைப்லைன்களில் பயன்படும் சிறப்புக் கட்டளை.",
  "gameHintWord485Algorithm": "கணினிச் சிக்கலைத் தீர்க்க வரையறுக்கப்பட்ட படிகளின் வரிசை.",
  "gameHintWord486Key": "குறியாக்கத்தைக் கட்டுப்படுத்த அல்லது சேமித்த தரவை அடையாளம் காணப் பயன்படும் மதிப்பு.",
  "gameHintWord487Alias": "ஷெல் கட்டளை அல்லது வளத்திற்கான மாற்றுப் பெயர்.",
  "gameHintWord488Amend": "மிகச் சமீபத்திய கமிட்டை மாற்றும் Git கமிட் விருப்பம்.",
  "gameHintWord489Allsigned": "கையொப்பமிட்ட ஸ்கிரிப்ட்களைத் தேவைப்படுத்தும் PowerShell இயக்கக் கொள்கை.",
  "gameHintWord490Remotesigned": "பதிவிறக்கிய ஸ்கிரிப்ட்களுக்கு கையொப்பம் தேவைப்படுத்தும் PowerShell கொள்கை.",
  "gameHintWord491Acl": "பயனர்கள் அல்லது அமைப்புகளுக்கான அனுமதிகளை வரையறுக்கும் பட்டியல்.",
  "gameHintWord492Uid": "Unix பயனருக்கு ஒதுக்கப்படும் எண் அடையாளங்காட்டி.",
  "gameHintWord493Setgid": "இயக்கம் அல்லது மரபுரிமையின்போது குழு அடையாளத்தைப் பாதிக்கும் அனுமதி பிட்.",
  "gameHintWord494Setfacl": "கோப்பு அணுகல் கட்டுப்பாட்டுப் பட்டியல்களை அமைக்கும் Linux கட்டளை.",
  "gameHintWord495Isolation": "பணிச்சுமைகள் ஒன்றையொன்று பாதிக்காதவாறு செய்யும் பிரிப்பு.",
  "gameHintWord496Sighup": "உள்ளமைவு மறுஏற்றத்தைக் கோரப் பயன்படும் Unix hangup சிக்னல்.",
  "gameHintWord497Sigint": "பொதுவாக Control-C மூலம் உருவாகும் Unix குறுக்கீட்டு சிக்னல்.",
  "gameHintWord498Sigstop": "செயலாக்கத்தை நிறுத்தாமல் இடைநிறுத்தும் Unix சிக்னல்.",
  "gameHintWord499Secrets": "கடவுச்சொற்கள், அணுகல் விசைகள் போன்ற உணர்திறன் மதிப்புகள்.",
  "gameHintWord500Secure": "அங்கீகாரமற்ற அணுகலுக்கு எதிராகப் பாதுகாக்கப்பட்ட இணைப்பை விவரிக்கிறது.",
